{
  "name": "foxypowers",
  "version": "0.1.5",
  "description": "Minimal OpenCode plugin with small repo-maintenance commands.",
  "type": "module",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxytanuki/foxypowers.git"
  },
  "license": "MIT",
  "files": [
    "commands",
    "skills",
    "src"
  ],
  "scripts": {
    "postinstall": "cfg=\"${XDG_CONFIG_HOME:-$HOME/.config}/opencode\"; mkdir -p \"$cfg/commands\" \"$cfg/skills\" && cp -f commands/*.md \"$cfg/commands/\" && cp -R skills/* \"$cfg/skills/\""
  }
}
